# ============================================================
#  dlss5nr - source-only repository ignores
#  Binaries, third-party runtime payloads and private notes are
#  NOT redistributed here (see README for how to obtain them).
#
#  Layout (see README "目录结构"):
#    src/       engine sources + build scripts + vendored headers
#    build/     build output (created by src/build.ps1)
#    runtime/   native runtime: onnxruntime + DirectML + webgpu plugin (not redistributed)
#    models/    model weights (not redistributed)
#    tools/     bundled portable node/ffmpeg (not redistributed)
#    web/       browser UI + local service
# ============================================================

# ---- build artifacts (all live under build/) ----
build/
*.obj
*.o
*.exe
*.pdb
*.ilk
*.exp
*.log
*.oldbin
*.bak
*.bak[0-9]

# ---- third-party model / forwarder binaries (not redistributed) ----
models/

# ---- native runtime payload: ONNX Runtime + DirectML + WebGPU plugin (not redistributed) ----
runtime/

# ---- bundled portable runtime (node/ffmpeg/ffprobe) ----
tools/

# ---- legacy paths: pre-2026-09 layout kept sources and runtime in core/ ----
core/dlss5nr_engine.exe
core/depth/*.dll
core/depth/*.onnx
server_guard.obj

# ---- NVIDIA driver log noise ----
NVIDIA Corporation/
core/NVIDIA Corporation/

# ---- runtime data / private notes / media ----
outputs/
.tmp_uploads/
.frame_previews/
.bench/
.workbuddy/
测试用视频/
example/

# ---- OS / editor junk ----
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
